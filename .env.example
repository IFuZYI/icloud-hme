# iCloud HME 环境变量示例
#
# 用法: 复制为 .env 后按需修改(复制出的 .env 已被 .gitignore 忽略; 本模板可入库)
#   cp .env.example .env
#
# 最小可用配置只需 ICLOUD_HME_ADMIN_PASSWORD。

# ── 必填 ────────────────────────────────────────────────────────────────
# 管理员密码: 至少 8 个字符。缺失或过短时服务拒绝启动。
# 留空会导致启动失败, 这是刻意的: 避免把占位密码带上线。
ICLOUD_HME_ADMIN_PASSWORD=

# ── 会话与安全 ──────────────────────────────────────────────────────────
# 会话有效期, 范围 15m–168h, 默认 12h。会话只存内存, 进程重启即失效。
#ICLOUD_HME_SESSION_TTL=12h

# 通过 HTTPS 反向代理部署时设为 true(Cookie 加 Secure 属性)。
#ICLOUD_HME_SECURE_COOKIE=false

# ── 日志 ────────────────────────────────────────────────────────────────
# 级别: debug / info / warn / error。排查认证或越权问题设为 debug。
#ICLOUD_HME_LOG_LEVEL=info

# 格式: text(易读) / json(便于日志系统采集)
#ICLOUD_HME_LOG_FORMAT=text

# 日志目录; 设为空字符串则只输出到 stdout/stderr。默认 <数据目录>/logs。
#ICLOUD_HME_LOG_DIR=

# ── 运行参数(本地脚本 ./run.sh 使用) ────────────────────────────────────
# 监听地址与数据目录; 直接运行二进制时也可用 -addr / -data 参数覆盖。
#ICLOUD_HME_ADDR=:8081
#ICLOUD_HME_DATA=./data

# ── Docker ──────────────────────────────────────────────────────────────
# 宿主机映射端口(默认 8081)。
#ICLOUD_HME_PORT=8081

# 容器运行 UID/GID: 默认 10001。若宿主机 ./data 属于其他用户,
# 设为 `id -u` / `id -g` 的值, 避免容器无权写入数据目录。
#ICLOUD_HME_UID=10001
#ICLOUD_HME_GID=10001

# 容器时区。
#TZ=Asia/Shanghai
